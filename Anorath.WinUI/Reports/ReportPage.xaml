<Page
    x:Class="Anorath.WinUI.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,24,24">
            <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True"/>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ReportBox" Header="Report" HorizontalAlignment="Stretch" SelectionChanged="ReportBox_SelectionChanged"/>
                <ComboBox x:Name="PresetBox" Grid.Column="1" Header="Period" HorizontalAlignment="Stretch" SelectionChanged="PresetBox_SelectionChanged"/>
                <CalendarDatePicker x:Name="FromPicker" Grid.Column="2" Header="From" HorizontalAlignment="Stretch"/>
                <CalendarDatePicker x:Name="ToPicker" Grid.Column="3" Header="To" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="4" Content="Generate" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="Generate_Click"/>
                <Button x:Name="PrintButton" Grid.Column="5" Content="Print / PDF" VerticalAlignment="Bottom" IsEnabled="False" Click="Print_Click"/>
                <Button x:Name="ExportButton" Grid.Column="6" Content="Export to Excel (CSV)" VerticalAlignment="Bottom" IsEnabled="False" Click="Export_Click"/>
            </Grid>

            <StackPanel x:Name="SummaryPanel" Orientation="Horizontal" Spacing="12"/>
            <StackPanel x:Name="TablesPanel" Spacing="24"/>
        </StackPanel>
    </ScrollViewer>
</Page>