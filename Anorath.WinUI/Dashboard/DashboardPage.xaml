<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anorath.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anorath.WinUI.Pages">

    <Page.Resources>
        <DataTemplate x:Key="KpiCardTemplate" x:DataType="local:KpiItem">
            <Grid Width="220" Height="112" Padding="16" RowSpacing="8" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{x:Bind Accent}"/>
                    <TextBlock Text="{x:Bind Title}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{x:Bind Value}" FontSize="26" FontWeight="SemiBold"
                           VerticalAlignment="Bottom"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="12" Padding="0,0,0,24">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="Spinner" IsActive="False" Width="20" Height="20"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.6"/>
            </StackPanel>

            <InfoBar x:Name="ErrorBar" Severity="Error" Title="Could not load the dashboard"
                     IsOpen="False" IsClosable="True"/>

            <TextBlock Text="Finance" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <GridView ItemsSource="{x:Bind FinanceKpis}" ItemTemplate="{StaticResource KpiCardTemplate}"
                      SelectionMode="None" IsItemClickEnabled="False"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

            <TextBlock Text="Operations" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <GridView ItemsSource="{x:Bind OperationsKpis}" ItemTemplate="{StaticResource KpiCardTemplate}"
                      SelectionMode="None" IsItemClickEnabled="False"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
        </StackPanel>
    </ScrollViewer>
</Page>