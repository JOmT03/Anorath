<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anorath.WinUI.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anorath.WinUI.Pages">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" Width="300"
                     PlaceholderText="Search code, name, contact or email"
                     KeyDown="SearchBox_KeyDown"/>
            <Button Content="Search" Click="Search_Click"/>
            <Button Content="Show all" Click="ShowAll_Click"/>
            <Button Content="+ Add Customer" Style="{StaticResource AccentButtonStyle}" Click="Add_Click"/>
        </StackPanel>

        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False"/>

        <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Padding="12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Code" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Contact" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="Email" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="Active" FontWeight="SemiBold"/>
            </Grid>

            <ListView x:Name="CustomersList" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:CustomerItem">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind CustomerCode}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind CustomerName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind ContactText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind EmailText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind ActiveText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                                <Button Content="Edit" Tag="{x:Bind CustomerId}" Click="Edit_Click"/>
                                <Button Content="Delete" Tag="{x:Bind CustomerId}" Click="Delete_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No customers found."
                       Opacity="0.6" Margin="12" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>