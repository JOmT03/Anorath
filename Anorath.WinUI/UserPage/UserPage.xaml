<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anorath.WinUI.Pages.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anorath.WinUI.Pages">

	<Grid RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Create and manage staff accounts for your company. Only the Admin can see this page."
                   Opacity="0.7" TextWrapping="Wrap"/>

		<!-- Search + Add -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
			<TextBox x:Name="SearchBox" Width="300"
                     PlaceholderText="Search username, name or role"
                     KeyDown="SearchBox_KeyDown"/>
			<Button Content="Search" Click="Search_Click"/>
			<Button Content="Show all" Click="ShowAll_Click"/>
			<Button Content="+ Add User" Style="{StaticResource AccentButtonStyle}" Click="Add_Click"/>
		</StackPanel>

		<InfoBar x:Name="MessageBar" Grid.Row="2" IsOpen="False"/>

		<!-- Table -->
		<Grid Grid.Row="3" RowSpacing="4">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Grid Padding="12,8" ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="180"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="140"/>
					<ColumnDefinition Width="90"/>
					<ColumnDefinition Width="170"/>
				</Grid.ColumnDefinitions>
				<TextBlock Text="Username" FontWeight="SemiBold"/>
				<TextBlock Grid.Column="1" Text="Full name" FontWeight="SemiBold"/>
				<TextBlock Grid.Column="2" Text="Role" FontWeight="SemiBold"/>
				<TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold"/>
			</Grid>

			<ListView x:Name="UsersList" Grid.Row="1" SelectionMode="None">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="local:UserItem">
						<Grid Padding="0,6" ColumnSpacing="12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="180"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="90"/>
								<ColumnDefinition Width="170"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{x:Bind Username}" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1" Text="{x:Bind FullName}" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="2" Text="{x:Bind Role}" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="3" Text="{x:Bind StatusText}" VerticalAlignment="Center"/>
							<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
								<Button Content="Edit" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanEdit}" Click="Edit_Click"/>
								<Button Content="Delete" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanEdit}" Click="Delete_Click"/>
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<TextBlock x:Name="EmptyText" Grid.Row="1" Text="No users found."
                       Opacity="0.6" Margin="12" Visibility="Collapsed"/>
		</Grid>
	</Grid>
</Page>