<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anorath.WinUI.Pages.ReservationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anorath.WinUI.Pages">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" Width="260"
                     PlaceholderText="Search guest, code or room"
                     KeyDown="SearchBox_KeyDown"/>
            <ComboBox x:Name="StatusFilter" Width="150" SelectionChanged="StatusFilter_SelectionChanged"/>
            <Button Content="Search" Click="Search_Click"/>
            <Button Content="Show all" Click="ShowAll_Click"/>
            <Button Content="+ New Reservation" Style="{StaticResource AccentButtonStyle}" Click="Add_Click"/>
        </StackPanel>

        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False"/>

        <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Padding="12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Guest" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Room" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Stay" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="Amount" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold"/>
            </Grid>

            <ListView x:Name="ReservationsList" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ReservationItem">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind CustomerName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind RoomNumber}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind StayText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind AmountText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Status}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                                <Button Content="Edit" Tag="{x:Bind ReservationId}" IsEnabled="{x:Bind CanEdit}" Click="Edit_Click"/>
                                <Button Content="Status" Tag="{x:Bind ReservationId}" IsEnabled="{x:Bind CanChangeStatus}" Click="Status_Click"/>
                                <Button Content="Delete" Tag="{x:Bind ReservationId}" IsEnabled="{x:Bind CanDelete}" Click="Delete_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No reservations found."
                       Opacity="0.6" Margin="12" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>