<Page
    x:Class="Anorath.WinUI.Pages.CompaniesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anorath.WinUI.Pages">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True"/>

        <StackPanel x:Name="SummaryPanel" Grid.Row="1" Orientation="Horizontal" Spacing="12"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" Width="280" PlaceholderText="Search code, company or plan" KeyDown="SearchBox_KeyDown"/>
            <Button Content="Search" Click="Search_Click"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
        </StackPanel>

        <Grid Grid.Row="3" Padding="12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Code" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="Company" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Plan" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="Server / Database" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="Users" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="Subscription" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="Status" FontWeight="SemiBold"/>
        </Grid>

        <ListView x:Name="CompaniesList" Grid.Row="4" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CompanyRow">
                    <Grid ColumnSpacing="8" Padding="0,8" Background="Transparent"
                          PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind CompanyCode}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind CompanyName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Plan}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ServerName}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind DbText}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{x:Bind UserCount}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="{x:Bind SubscriptionText}" Foreground="{x:Bind SubscriptionBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="6" Text="{x:Bind StatusText}" Foreground="{x:Bind StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="7" Content="⋯" Opacity="0.3" Padding="8,2" Background="Transparent" BorderThickness="0">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Test connection" Tag="{x:Bind CompanyId}" Click="TestConnection_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="World"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Edit name / plan" Tag="{x:Bind CompanyId}" Click="Edit_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Edit"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Extend subscription" Tag="{x:Bind CompanyId}" Click="Extend_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Calendar"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="{x:Bind ToggleText}" Tag="{x:Bind CompanyId}" Click="ToggleStatus_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Permissions"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Grid.Row="4" Margin="12" Opacity="0.6" Text="No companies found." Visibility="Collapsed"/>
    </Grid>
</Page>