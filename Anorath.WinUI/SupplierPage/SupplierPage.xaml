<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anorath.WinUI.Pages.SuppliersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anorath.WinUI.Pages">

    <Grid ColumnSpacing="24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <InfoBar x:Name="MessageBar" Grid.ColumnSpan="2" IsOpen="False"/>

        <!-- LEFT: suppliers -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Suppliers" FontSize="18" FontWeight="SemiBold"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="SearchBox" Width="190" PlaceholderText="Search supplier" KeyDown="SearchBox_KeyDown"/>
                <Button Content="Search" Click="Search_Click"/>
                <Button Content="+ Add Supplier" Style="{StaticResource AccentButtonStyle}" Click="AddSupplier_Click"/>
            </StackPanel>

            <ListView x:Name="SuppliersList" Grid.Row="2" SelectionMode="Single"
                      SelectionChanged="SuppliersList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SupplierRow">
                        <Grid Padding="0,8" ColumnSpacing="8" Background="Transparent"
                              PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind SupplierName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind SubText}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="⋯" Opacity="0.3" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Edit" Tag="{x:Bind SupplierId}" Click="EditSupplier_Click"/>
                                        <MenuFlyoutItem Text="Delete" Tag="{x:Bind SupplierId}" Click="DeleteSupplier_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptySuppliersText" Grid.Row="2" Text="No suppliers yet."
                       Opacity="0.6" Margin="12" Visibility="Collapsed"/>
        </Grid>

        <!-- RIGHT: items of the selected supplier -->
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ItemsTitle" Text="Items" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

            <Button x:Name="AddItemButton" Grid.Row="1" Content="+ Add Item" IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" Click="AddItem_Click"/>

            <Grid Grid.Row="2" Padding="12,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Item" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Unit" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Price" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="Active" FontWeight="SemiBold"/>
            </Grid>

            <ListView x:Name="ItemsList" Grid.Row="3" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SupplierItemRow">
                        <Grid Padding="0,6" ColumnSpacing="12" Background="Transparent"
                              PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ItemName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Unit}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind PriceText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind ActiveText}" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Content="⋯" Opacity="0.3" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Edit" Tag="{x:Bind SupplierItemId}" Click="EditItem_Click"/>
                                        <MenuFlyoutItem Text="Delete" Tag="{x:Bind SupplierItemId}" Click="DeleteItem_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyItemsText" Grid.Row="3" Text="Select a supplier on the left to see its items."
                       Opacity="0.6" Margin="12" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Page>