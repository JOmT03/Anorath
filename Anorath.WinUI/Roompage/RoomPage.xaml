<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anorath.WinUI.Pages.RoomsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anorath.WinUI.Pages">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search, filter, add -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" Width="260"
                     PlaceholderText="Search room number or type"
                     KeyDown="SearchBox_KeyDown"/>
            <ComboBox x:Name="StatusFilter" Width="160" SelectionChanged="StatusFilter_SelectionChanged"/>
            <Button Content="Search" Click="Search_Click"/>
            <Button Content="Show all" Click="ShowAll_Click"/>
            <Button Content="+ Add Room" Style="{StaticResource AccentButtonStyle}" Click="Add_Click"/>
        </StackPanel>

        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False"/>

        <!-- Table -->
        <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Padding="12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Room" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Rate / night" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="Active" FontWeight="SemiBold"/>
            </Grid>

            <ListView x:Name="RoomsList" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:RoomItem">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind RoomNumber}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind RoomType}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind RateText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind Status}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind ActiveText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                                <Button Content="Edit" Tag="{x:Bind RoomId}" Click="Edit_Click"/>
                                <Button Content="Delete" Tag="{x:Bind RoomId}" Click="Delete_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No rooms found."
                       Opacity="0.6" Margin="12" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>