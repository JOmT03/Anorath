<Page
    x:Class="Anorath.WinUI.Pages.PayrollPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anorath.WinUI.Pages">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True"/>

        <Pivot Grid.Row="1">
            <!-- ================= EMPLOYEES ================= -->
            <PivotItem Header="Employees">
                <Grid RowSpacing="8" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="EmpSearchBox" Width="260" PlaceholderText="Search code, name or position"
                                 KeyDown="EmpSearchBox_KeyDown"/>
                        <Button Content="Search" Click="EmpSearch_Click"/>
                        <Button Content="+ Add Employee" Style="{StaticResource AccentButtonStyle}" Click="AddEmployee_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Padding="12,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Code" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Position" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Daily rate" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Date hired" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Active" FontWeight="SemiBold"/>
                    </Grid>

                    <ListView x:Name="EmployeesList" Grid.Row="2" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EmployeeRow">
                                <Grid ColumnSpacing="8" Padding="0,6" Background="Transparent"
                                      PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind EmployeeCode}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind FullName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind PositionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind RateText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind HiredText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind ActiveText}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="6" Content="⋯" Opacity="0.3" Padding="8,2" Background="Transparent" BorderThickness="0">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Run payroll" Tag="{x:Bind EmployeeId}" Click="RunPayrollFor_Click" IsEnabled="{x:Bind IsActive}">
                                                    <MenuFlyoutItem.Icon>
                                                        <SymbolIcon Symbol="Calculator"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Edit" Tag="{x:Bind EmployeeId}" Click="EditEmployee_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <SymbolIcon Symbol="Edit"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Delete" Tag="{x:Bind EmployeeId}" Click="DeleteEmployee_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <SymbolIcon Symbol="Delete"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyEmployeesText" Grid.Row="2" Margin="12" Opacity="0.6"
                               Text="No employees yet. Click + Add Employee." Visibility="Collapsed"/>
                </Grid>
            </PivotItem>

            <!-- ================= PAYROLL RECORDS ================= -->
            <PivotItem Header="Payroll Records">
                <Grid RowSpacing="8" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="EmployeeFilter" Width="260" DisplayMemberPath="FullName"
                                  SelectionChanged="EmployeeFilter_SelectionChanged"/>
                        <Button Content="+ Run Payroll" Style="{StaticResource AccentButtonStyle}" Click="RunPayroll_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Padding="12,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Employee" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Pay period" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Days" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Daily rate" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Gross pay" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Deductions" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="Net pay" FontWeight="SemiBold"/>
                    </Grid>

                    <ListView x:Name="PayrollList" Grid.Row="2" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PayrollRow">
                                <Grid ColumnSpacing="8" Padding="0,6" Background="Transparent"
                                      PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind EmployeeName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind PeriodText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind DaysText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind RateText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind GrossText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind DeductionsText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{x:Bind NetText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="7" Content="⋯" Opacity="0.3" Padding="8,2" Background="Transparent" BorderThickness="0">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Print payslip" Tag="{x:Bind PayrollRecordId}" Click="PrintPayslip_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <SymbolIcon Symbol="Print"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Delete" Tag="{x:Bind PayrollRecordId}" Click="DeletePayroll_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <SymbolIcon Symbol="Delete"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyPayrollText" Grid.Row="2" Margin="12" Opacity="0.6"
                               Text="No payroll records yet. Click + Run Payroll." Visibility="Collapsed"/>

                    <TextBlock x:Name="PayrollSummaryText" Grid.Row="3" Opacity="0.8"/>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>