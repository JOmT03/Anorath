<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anorath.WinUI.Pages.PosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anorath.WinUI.Pages">

	<Grid RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- New sale -->
		<Border Padding="16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
			<StackPanel Spacing="12">
				<TextBlock Text="New sale" FontSize="18" FontWeight="SemiBold"/>
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ComboBox x:Name="ItemBox" Header="Menu item" Width="340" SelectionChanged="Inputs_Changed"/>
					<NumberBox x:Name="QtyBox" Header="Qty" Width="110" Minimum="1" Maximum="100" Value="1"
                               SpinButtonPlacementMode="Compact" ValueChanged="QtyBox_ValueChanged"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ComboBox x:Name="PaymentBox" Header="Payment" Width="180" SelectionChanged="PaymentBox_SelectionChanged"/>
					<ComboBox x:Name="GuestBox" Header="Guest (Charge to Room)" Width="270" IsEnabled="False"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="16">
					<TextBlock x:Name="TotalText" Text="Total: ₱0.00" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
					<Button Content="Record Sale" Style="{StaticResource AccentButtonStyle}" Click="Record_Click"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False"/>

		<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
			<TextBlock Text="Today's sales" FontSize="18" FontWeight="SemiBold"/>
			<TextBlock x:Name="TodayTotalText" Opacity="0.7" VerticalAlignment="Bottom"/>
		</StackPanel>

		<Grid Grid.Row="3" RowSpacing="4">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Grid Padding="12,8" ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="80"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="50"/>
					<ColumnDefinition Width="110"/>
					<ColumnDefinition Width="120"/>
					<ColumnDefinition Width="150"/>
					<ColumnDefinition Width="80"/>
				</Grid.ColumnDefinitions>
				<TextBlock Text="Time" FontWeight="SemiBold"/>
				<TextBlock Grid.Column="1" Text="Item" FontWeight="SemiBold"/>
				<TextBlock Grid.Column="2" Text="Qty" FontWeight="SemiBold"/>
				<TextBlock Grid.Column="3" Text="Total" FontWeight="SemiBold"/>
				<TextBlock Grid.Column="4" Text="Payment" FontWeight="SemiBold"/>
				<TextBlock Grid.Column="5" Text="Guest" FontWeight="SemiBold"/>
			</Grid>

			<ListView x:Name="SalesList" Grid.Row="1" SelectionMode="None">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="local:SaleItem">
						<Grid Padding="0,6" ColumnSpacing="12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="80"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="50"/>
								<ColumnDefinition Width="110"/>
								<ColumnDefinition Width="120"/>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="80"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{x:Bind TimeText}" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1" Text="{x:Bind ItemName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
							<TextBlock Grid.Column="2" Text="{x:Bind Quantity}" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="3" Text="{x:Bind TotalText}" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="4" Text="{x:Bind PaymentMethod}" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="5" Text="{x:Bind Guest}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
							<Button Grid.Column="6" Content="Void" Tag="{x:Bind SaleId}" IsEnabled="{x:Bind CanVoid}" Click="Void_Click"/>
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<TextBlock x:Name="EmptyText" Grid.Row="1" Text="No sales yet today."
                       Opacity="0.6" Margin="12" Visibility="Collapsed"/>
		</Grid>
	</Grid>
</Page>